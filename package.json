    "depcheck": "^1.4.7",
    "eslint": "^10.7.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-tools": "^13.12.0",
    "globals": "^17.9.0",
    "vite-plugin-compression": "^0.5.1"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
